void sort_array(int size, int a[])
{
    for (int i = 0; i < (size - 1); i++)
    {
        for (int j = 0; j < ((size - 1) - i); j++)
        {
            if (a[j] > a[j + 1])
            {
                int temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
}

