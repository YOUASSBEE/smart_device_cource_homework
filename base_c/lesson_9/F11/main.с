#include <stdio.h>

#define N 30

void find_min_sum_pair(int arr[]) {
  int min_idx1 = 0;
  int min_idx2 = 1;
  int min_sum = arr[0] + arr[1];

  for (int i = 0; i < N - 1; i++) {
    for (int j = i + 1; j < N; j++) {
      int current_sum = arr[i] + arr[j];
      if (current_sum < min_sum) {
        min_sum = current_sum;
        min_idx1 = i;
        min_idx2 = j;
      }
    }
  }

  if (min_idx1 < min_idx2) {
    printf("%d %d", min_idx1, min_idx2);
  } else {
    printf("%d %d", min_idx2, min_idx1);
  }
}

int main() {
  int arr[N];

  for (int i = 0; i < N; i++) {
    scanf("%d", &arr[i]);
  }

  find_min_sum_pair(arr);

  return 0;
}