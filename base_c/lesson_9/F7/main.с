int compression(int a[], int b[], int N)
{
  if (N == 0)
  {
    return 0;
  }

  int compressed_index = 0;
  int current_index = 0;

  if (a[0] == 0)
  {
    int count = 0;
    while (current_index < N && a[current_index] == 0)
    {
      count++;
      current_index++;
    }
    b[compressed_index++] = count;
  } 
  else 
  {
    b[compressed_index++] = 0;
  }

  while (current_index < N)
  {
    int current_value = a[current_index];
    int count = 0;

    while (current_index < N && a[current_index] == current_value)
    {
      count++;
      current_index++;
    }

    b[compressed_index++] = count;
  }

  return compressed_index;
}

