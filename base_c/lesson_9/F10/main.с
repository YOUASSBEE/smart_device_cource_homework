#include <locale.h>
#include <stdio.h>
#include <string.h>

int main() {
  char str[1001];
  scanf("%s", str);

  int len = strlen(str);
  if (len > 0 && str[len - 1] == '.') {
    len--;
  }

  if (len == 0) {
    printf(".\n");
    return 0;
  }

  char result[2000];
  int res_index = 0;

  int count = 1;
  char current = str[0];

  for (int i = 1; i <= len; i++) {
    if (i < len && str[i] == current) {
      count++;
    } else {
      result[res_index++] = current;

      char num_str[10];
      sprintf(num_str, "%d", count);
      for (int j = 0; num_str[j] != '\0'; j++) {
        result[res_index++] = num_str[j];
      }

      if (i < len) {
        current = str[i];
        count = 1;
      }
    }
  }

  result[res_index] = '\0';

  printf("%s\n", result);

  return 0;
}