#include <stdio.h>

#define SIZE 5

double average_main_diagonal(int matrix[SIZE][SIZE]) {
  double sum = 0.0;
  for (int i = 0; i < SIZE; i++) {
    sum += matrix[i][i];
  }
  return sum / SIZE;
}

int main() {
  int matrix[SIZE][SIZE];

  for (int i = 0; i < SIZE; i++) {
    for (int j = 0; j < SIZE; j++) {
      scanf("%d", &matrix[i][j]);
    }
  }

  double avg = average_main_diagonal(matrix);
  int count = 0;

  for (int i = 0; i < SIZE; i++) {
    for (int j = 0; j < SIZE; j++) {
      if (matrix[i][j] > 0 && matrix[i][j] > avg) {
        count++;
      }
    }
  }

  printf("%d\n", count);
  return 0;
}