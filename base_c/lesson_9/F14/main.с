int sum_between_ab(int from, int to, int size, int a[]) {

  int left = from < to ? from : to;
  int right = from > to ? from : to;

  int sum = 0;

  for (int i = 0; i < size; i++) {
    if (a[i] >= left && a[i] <= right) {
      sum += a[i];
    }
  }

  return sum;
}

