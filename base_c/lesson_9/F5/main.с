int find_max_array(int size, int a[]) {
    if (size <= 0) {
        return 0;
    }
    
    int max = a[0];
    
    for (int i = 1; i < size; i++) {
        if (a[i] > max) {
            max = a[i];
        }
    }
    
    return max;
}

