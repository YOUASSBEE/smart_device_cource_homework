#include <stdio.h>

#define N 5

int trace_matrix(int mat[N][N]) {
  int trace = 0;
  for (int i = 0; i < N; i++) {
    trace += mat[i][i];
  }
  return trace;
}

int main() {
  int matrix[N][N];

  for (int i = 0; i < N; i++) {
    for (int j = 0; j < N; j++) {
      scanf("%d", &matrix[i][j]);
    }
  }

  int trace = trace_matrix(matrix);

  printf("%d", trace);

  return 0;
}