void sort_even_odd(int n, int a[])
{   
    int count = 0;
    int tmp[20] = {0};
    for (int i = 0; i < n; i++)
    {
        if (!(a[i] % 2))
        {
            tmp[count] = a[i];
            count++;
        }
    }

    for (int i = 0; i < n; i++)
    {
        if (a[i] % 2)
        {
            tmp[count] = a[i];
            count++;
        }
    }

    for (int i = 0; i < n; i++)
    {
        a[i] = tmp[i];
    }

}

