#include <stdio.h>
#include <locale.h>

int main() 
{
    //setlocale(LC_ALL, "Rus");    
    setlocale(LC_ALL, "en_US.UTF-8");

    #define ARRNUMBER 10
    
    int numArray[ARRNUMBER] = {0};

    int sizeOfArr = ARRNUMBER;

    for (int i = 0; i < sizeOfArr; i++)
    {
        scanf("%d", &numArray[i]);
    }

    int temp = numArray[ARRNUMBER - 1];

    for (int i = ARRNUMBER - 1; i > 0; i--)
    {
        numArray[i] = numArray[i-1];
    }

    numArray[0] = temp;

    for (int i = 0; i < sizeOfArr; i++)
    {
        printf("%d ", numArray[i]);
    }
    
    return 0;
}