#include <stdio.h>
#include <locale.h>

int main()
{
    //setlocale(LC_ALL, "Rus");    
    setlocale(LC_ALL, "en_US.UTF-8");
    
    #define ARRNUMBER 10
    int sizeOfArr = ARRNUMBER;
    int numArray[ARRNUMBER];
    int tempArray[ARRNUMBER];
    int count = 0;
    

    for (int i = 0; i < sizeOfArr; i++)
    {
        scanf("%d", &numArray[i]);
    }
    
    for (int i = 0; i < sizeOfArr; i++)
    {
        int tens = (numArray[i] < 0 ? -numArray[i] : numArray[i]) / 10 % 10;
        
        if (tens == 0)
        {
            tempArray[count] = numArray[i];
            count++;
        }
    }
    
    for (int i = 0; i < count; i++)
    {
        printf("%d ", tempArray[i]);
    }
    
    return 0;
}